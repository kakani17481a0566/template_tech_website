exports.push([module.i, "\ncanvas[data-v-6dc7a5d3] {\n    border: 1px solid black;\n}\n", "", {"version":3,"sources":["/buddy/igs-old-site-review/web/app/themes/igs/resources/assets/scripts/components/scripts/components/EnrolmentFormStep3.vue"],"names":[],"mappings":";AAy0BA;IACA,wBAAA;CACA","file":"EnrolmentFormStep3.vue","sourcesContent":["<template>\n    <form action=\"\" enctype=\"multipart/form-data\">\n        <div class=\"msg msg-error\" v-if=\"errors.items.length\">\n            <p>There were some error(s) with your submission:</p>\n            <ul>\n                <li v-for=\"(error, index) in errors.items\" v-bind:key=\"index\" v-html=\"error.msg\"></li>\n            </ul>\n        </div>\n        <h2 v-if=\"!earlyLearner\">Present School</h2>\n\n        <div class=\"row\" v-if=\"!earlyLearner\">\n            <div class=\"col-12\">\n                <label for=\"not_attending\">Not yet attending school?</label>\n                <input type=\"checkbox\" name=\"not_attending\" v-model=\"formData.not_attending\">\n            </div>\n        </div>\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"current_school_name\" class=\"label-required\">School Name</label>\n                <input type=\"text\" name=\"current_school_name\" id=\"current_school_name\"\n                       data-vv-as=\"Current School\"\n                       v-model=\"formData.current_school_name\">\n                <span v-show=\"errors.has('current_school_name')\"\n                      class=\"error\">{{ errors.first('current_school_name') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"current_school_grade\" class=\"label-required\">Grade*</label>\n                <select name=\"current_school_grade\" id=\"current_school_grade\" v-model=\"formData.current_school_grade\"\n                        required\n                        v-validate=\"formData.not_attending === false ? 'required': ''\"\n                        data-vv-as=\"Current School Grade\">\n                    <option value=\"\">Select</option>\n                    <option value=\"K\" v-bind:selected=\"form && form.current_school_grade === 'K'\">K</option>\n                    <option v-for=\"number in 12\" v-bind:key=\"number\" :value=\"number\" v-html=\"number\"\n                            v-bind:selected=\"form && form.current_school_grade === number\"></option>\n                </select>\n                <span v-show=\"errors.has('current_school_grade')\"\n                      class=\"error\">{{ errors.first('current_school_grade') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\"\n             v-if=\"!earlyLearner && !formData.not_attending\"\n             v-show=\"formData.current_school_grade !== 'K' && formData.current_school_grade !== ''\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Most recent school report*</label>\n                <div class=\"form-upload dropzone\" data-field=\"current_school_report\" data-maxFiles=\"2\">\n                    <div class=\"dz-message\">\n                        <p><i class=\"fa fa-cloud-upload fa-2x yellow\" aria-hidden=\"true\"></i></p>\n                        <p>Drop files here or click to upload.</p>\n                        <p>\n                            <small>(Max File Size: {{ maxFileSize }}Mb - Filetypes allowed: {{ fileTypes }} )\n\n                            </small>\n                        </p>\n                        <p class=\"label-note\">Uploading a new file will replace the old file</p>\n                    </div>\n\n                    <!--<input type=\"file\" name=\"birth_certificate\" id=\"birth_certificate\" v-validate=\"'required'\">-->\n                    <p v-if=\"Array.isArray(formData.current_school_report)\">\n                        Currently uploaded file(s):\n                        <span v-for=\"(file, index) in formData.current_school_report\" v-bind:key=\"index\"\n                              v-if=\"file.title\"\n                        >{{file.title}},&nbsp; </span>\n                    </p>\n                    <section v-if=\"Array.isArray(formData.current_school_report)\">\n                        <input type=\"hidden\" name=\"current_school_report[]\"\n                               v-for=\"file in formData.current_school_report\"\n                               v-bind:key=\"file.ID\"\n                               :value=\"file.ID || file\"\n                               data-vv-as=\"Current School Report\"\n                               v-validate=\"'required|not_in:0'\">\n                    </section>\n                    <span v-show=\"errors.has('current_school_report')\"\n                          class=\"error\">{{ errors.first('current_school_report') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"current_school_date_started\" class=\"label-required\">Date Started</label>\n                <input type=\"text\" name=\"current_school_date_started\" id=\"current_school_date_started\"\n                       data-vv-as=\"Date Started\"\n                       v-model=\"formData.current_school_date_started\">\n                <span v-show=\"errors.has('current_school_date_started')\"\n                      class=\"error\">{{ errors.first('current_school_date_started') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Is student still attending*</label>\n                <div class=\"form-checkbox\">\n                    <label><input type=\"radio\" name=\"current_school_still_attending_yes_no\"\n                                  v-validate=\"'required'\" data-vv-as=\"Still attending\"\n                                  v-model=\"formData.current_school_still_attending_yes_no\" value=\"Yes\">\n                        Yes</label>\n                    <label><input type=\"radio\" name=\"current_school_still_attending_yes_no\"\n                                  v-model=\"formData.current_school_still_attending_yes_no\" value=\"No\">\n                        No</label>\n                    <span v-show=\"errors.has('current_school_still_attending_yes_no')\"\n                          class=\"error\">{{ errors.first('current_school_still_attending_yes_no') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.current_school_still_attending_yes_no == 'No'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"current_school_last_attendance_date\"\n                       class=\"label-required\">Last Attendance Date*</label>\n                <input type=\"text\" name=\"current_school_last_attendance_date\" id=\"current_school_last_attendance_date\"\n                       v-validate=\"formData.current_school_still_attending_yes_no == 'No' ? 'required' : ''\"\n                       data-vv-as=\"Last attendance date\"\n                       v-model=\"formData.current_school_last_attendance_date\">\n                <span v-show=\"errors.has('current_school_last_attendance_date')\"\n                      class=\"error\">{{ errors.first('current_school_last_attendance_date') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.current_school_still_attending_yes_no == 'No'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"current_school_reasons_for_leaving\"\n                       class=\"label-required\">Reasons for leaving*</label>\n                <input type=\"text\" name=\"current_school_reasons_for_leaving\" id=\"current_school_reasons_for_leaving\"\n                       v-model=\"formData.current_school_reasons_for_leaving\">\n                <span v-show=\"errors.has('current_school_reasons_for_leaving')\"\n                      class=\"error\">{{ errors.first('current_school_reasons_for_leaving') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Previous Schools</label>\n                <textarea name=\"previous_schools\" id=\"previous_schools\" cols=\"30\" rows=\"10\"\n                          v-model=\"formData.previous_schools\"></textarea>\n                <span v-show=\"errors.has('previous_schools')\"\n                      class=\"error\">{{ errors.first('previous_schools') }}</span>\n            </div>\n        </div>\n\n        <hr class=\"alt\" v-if=\"!earlyLearner && !formData.not_attending\">\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Has the student undergone any testing for learning difficulties or\n                    accelerated learning?</label>\n                <div class=\"form-checkbox\">\n                    <label><input type=\"radio\" name=\"learning_difficulty_testing_yes_no\"\n                                  v-model=\"formData.learning_difficulty_testing_yes_no\" value=\"No\">\n                        No</label>\n                    <label><input type=\"radio\" name=\"learning_difficulty_testing_yes_no\"\n                                  v-model=\"formData.learning_difficulty_testing_yes_no\" value=\"Yes\">\n                        Yes</label>\n                    <span v-show=\"errors.has('learning_difficulty_testing_yes_no')\"\n                          class=\"error\">{{ errors.first('learning_difficulty_testing_yes_no') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.learning_difficulty_testing_yes_no == 'Yes'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"learning_difficulty_testing_details\"\n                       class=\"label-required\">Please provide details</label>\n                <input type=\"text\" name=\"learning_difficulty_testing_details\" id=\"learning_difficulty_testing_details\"\n                       :value=\"formData.learning_difficulty_testing_details\">\n                <span v-show=\"errors.has('learning_difficulty_testing_details')\"\n                      class=\"error\">{{ errors.first('learning_difficulty_testing_details') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.learning_difficulty_testing_yes_no == 'Yes'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label>Please provide copies of reports*</label>\n                <div class=\"form-upload dropzone\" data-field=\"learning_difficulty_testing_reports\" data-maxFiles=\"5\">\n                    <div class=\"dz-message\">\n                        <p><i class=\"fa fa-cloud-upload fa-2x yellow\" aria-hidden=\"true\"></i></p>\n                        <p>Drop files here or click to upload.</p>\n                        <p>\n                            <small>(Max File Size: {{ maxFileSize }}Mb - Filetypes allowed: {{ fileTypes }} )\n                            </small>\n                        </p>\n                        <p class=\"label-note\">Uploading a new file will replace the old file</p>\n                    </div>\n                    <section v-if=\"Array.isArray(formData.learning_difficulty_testing_reports)\">\n                        <input type=\"hidden\" name=\"learning_difficulty_testing_reports[]\"\n                               v-for=\"file in formData.learning_difficulty_testing_reports\"\n                               v-bind:key=\"file.ID\"\n                               :value=\"file.ID || file\"\n                               data-vv-as=\"Learning difficulty Report\"\n                               v-validate=\"'required|not_in:0'\">\n                    </section>\n                    <p class=\"label-note\">Uploading a new file will replace the old file</p>\n                    <span v-show=\"errors.has('learning_difficulty_testing_reports')\"\n                          class=\"error\">{{ errors.first('learning_difficulty_testing_reports') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <hr class=\"alt\" v-if=\"!earlyLearner && !formData.not_attending\">\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Has the student received special assistance with any school\n                    subjects?</label>\n                <div class=\"form-checkbox\">\n                    <label><input type=\"radio\" name=\"learning_difficulty_assistance_yes_no\"\n                                  v-model=\"formData.learning_difficulty_assistance_yes_no\" value=\"No\">\n                        No</label>\n                    <label><input type=\"radio\" name=\"learning_difficulty_assistance_yes_no\"\n                                  v-model=\"formData.learning_difficulty_assistance_yes_no\" value=\"Yes\">\n                        Yes</label>\n                    <span v-show=\"errors.has('learning_difficulty_assistance_yes_no')\"\n                          class=\"error\">{{ errors.first('learning_difficulty_assistance_yes_no') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.learning_difficulty_assistance_yes_no == 'Yes'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"learning_difficulty_assistance_school_or_private\" class=\"label-required\">Has this been at\n                    school or privately arranged?</label>\n                <input type=\"text\" name=\"learning_difficulty_assistance_school_or_private\"\n                       v-model=\"formData.learning_difficulty_assistance_school_or_private\"\n                       id=\"learning_difficulty_assistance_school_or_private\">\n                <span v-show=\"errors.has('learning_difficulty_assistance_school_or_private')\"\n                      class=\"error\">{{ errors.first('learning_difficulty_assistance_school_or_private') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.learning_difficulty_assistance_yes_no == 'Yes'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"learning_difficulty_assistance_details\" class=\"label-required\">At whose suggestion and for\n                    what reason was the assistance provided?</label>\n                <input type=\"text\" name=\"learning_difficulty_assistance_details\"\n                       v-model=\"formData.learning_difficulty_assistance_details\"\n                       id=\"learning_difficulty_assistance_details\">\n                <span v-show=\"errors.has('learning_difficulty_assistance_details')\"\n                      class=\"error\">{{ errors.first('learning_difficulty_assistance_details') }}</span>\n            </div>\n        </div>\n\n        <hr class=\"alt\" v-if=\"!earlyLearner && !formData.not_attending\">\n\n        <div class=\"row\" v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Has the student any medical requirements or special needs of which the\n                    School should be aware?</label>\n                <div class=\"form-checkbox\">\n                    <label><input type=\"radio\" name=\"special_needs_yes_no\"\n                                  v-model=\"formData.special_needs_yes_no\" value=\"No\"> No</label>\n                    <label><input type=\"radio\" name=\"special_needs_yes_no\"\n                                  v-model=\"formData.special_needs_yes_no\" value=\"Yes\"> Yes</label>\n                    <span v-show=\"errors.has('special_needs_yes_no')\"\n                          class=\"error\">{{ errors.first('special_needs_yes_no') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.special_needs_yes_no == 'Yes'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label for=\"special_needs_details\" class=\"label-required\">Please provide brief details</label>\n                <input type=\"text\" name=\"special_needs_details\" id=\"special_needs_details\"\n                       v-model=\"formData.special_needs_details\">\n                <span v-show=\"errors.has('special_needs_details')\"\n                      class=\"error\">{{ errors.first('special_needs_details') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.special_needs_yes_no == 'Yes'\"\n             v-if=\"!earlyLearner && !formData.not_attending\">\n            <div class=\"col-12\">\n                <label>Please attach any relevant documents</label>\n                <div class=\"form-upload dropzone\" data-field=\"special_needs_documents\" data-maxFiles=\"5\">\n                    <div class=\"dz-message\">\n                        <p><i class=\"fa fa-cloud-upload fa-2x yellow\" aria-hidden=\"true\"></i></p>\n                        <p>Drop files here or click to upload.</p>\n                        <p>\n                            <small>(Max File Size: {{ maxFileSize }}Mb - Filetypes allowed: {{ fileTypes }} )\n\n                            </small>\n                        </p>\n                        <p class=\"label-note\">Uploading a new file will replace the old file</p>\n                    </div>\n\n                    <section v-if=\"Array.isArray(formData.special_needs_documents)\">\n                        <p>Current Files:</p>\n                        <p v-for=\"attachment in formData.special_needs_documents\"\n                           v-bind:key=\"attachment.ID\"\n                           v-html=\"attachment.title\"></p>\n                        <input type=\"hidden\"\n                               name=\"special_needs_documents[]\"\n                               v-for=\"attachment in formData.special_needs_documents\"\n                               v-bind:key=\"attachment.ID\"\n                               :value=\"attachment.ID || attachment\"/>\n                    </section>\n                    <span v-show=\"errors.has('special_needs_documents')\"\n                          class=\"error\">{{ errors.first('special_needs_documents') }}</span>\n                </div>\n            </div>\n        </div>\n\n        <hr class=\"alt\" v-if=\"!earlyLearner && !formData.not_attending\">\n\n        <p>\n            It is important that the School is aware of any learning, behavioural, medical or legal issues so as best\n            support students both academically and socially. This may include medical or psychological issues, physical\n            or intellectual conditions or disabilities.</p>\n\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <label>Please attach any relevant documentation relating to medical, educational, or legal matters (i.e.\n                    court/parenting orders) so that the school may fulfil its duty of care and provide your child with\n                    the best possible learning environment.*</label>\n                <div class=\"form-upload dropzone\" data-field=\"enrolment_legal_docs\" data-maxFiles=\"1\">\n                    <div class=\"dz-message\">\n                        <p><i class=\"fa fa-cloud-upload fa-2x yellow\" aria-hidden=\"true\"></i></p>\n                        <p>Drop files here or click to upload.</p>\n                        <p>\n                            <small>(Max File Size: {{ maxFileSize }}Mb - Filetypes allowed: {{ fileTypes }} )\n\n                            </small>\n                        </p>\n                        <p class=\"label-note\">Uploading a new file will replace the old file</p>\n                    </div>\n\n                    <!--<input type=\"file\" name=\"birth_certificate\" id=\"birth_certificate\" v-validate=\"'required'\">-->\n                    <section v-if=\"Array.isArray(formData.enrolment_legal_docs)\">\n                        <input type=\"hidden\" name=\"enrolment_legal_docs[]\"\n                               v-for=\"file in formData.enrolment_legal_docs\"\n                               v-bind:key=\"file.ID\"\n                               :value=\"file.ID || file\"\n                               data-vv-as=\"Enrolment legal documents\"\n                               v-validate=\"'required|not_in:0'\">\n                    </section>\n\n                    <span v-show=\"errors.has('enrolment_legal_docs')\"\n                          class=\"error\">{{ errors.first('enrolment_legal_docs') }}</span>\n                </div>\n                <!--<input type=\"file\" name=\"enrolment_legal_docs\" id=\"enrolment_legal_docs\">-->\n            </div>\n        </div>\n\n        <hr class=\"alt\">\n\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <ol class=\"oa-declaration\">\n                    <li>\n                        I/we desire to enrol my/our child (as shown above) at International Grammar School (IGS) in\n                        accordance with the terms and conditions of enrolment.\n                    </li>\n                    <li>\n                        I/we understand that if this application is successful, enrolment can only be confirmed with a\n                        formal letter of offer from the principal.\n                    </li>\n                    <li>I/we declare that the information provided on this form is true and correct.</li>\n                    <li>\n                        I/we agree to keep the school advised of any changes to our contact details, particularly email\n                        addresses and mobile phone numbers.\n                    </li>\n                </ol>\n                <div class=\"form-inputonly\">\n                    <p><a :href=\"policyFile.url\" target=\"_blank\"\n                          class=\"button button-sm button-secondary\">View enrolment policy</a></p>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <label class=\"label-required\">Confirm enrolment policy*</label>\n                <div class=\"form-checkbox\">\n                    <label><input type=\"checkbox\" name=\"enrolment_policy_confirm\" id=\"enrolment_policy_confirm\"\n                                  v-model=\"formData.enrolment_policy_confirm\"\n                                  v-validate=\"'required'\" data-vv-as=\"Policy\"\n                                  value=\"Yes\"\n                                  required> Yes</label>\n                    <p>\n                    <span v-show=\"errors.has('enrolment_policy_confirm')\"\n                          class=\"error\">{{ errors.first('enrolment_policy_confirm') }}</span>\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <p>Please use your mouse to sign electronically in the box below</p>\n                <label for=\"signature_1\">Parent/Carer 1 Signature</label>\n                <canvas id=\"signature_1\" @mousemove=\"draw\" @mousedown=\"mouseDown\" @mouseup=\"mouseUp\"\n                        @mouseout=\"isDrawing = false\"></canvas>\n                <button class=\"clearSignature\" @click.prevent=\"clearCanvas('signature_1')\">Clear Signature</button>\n                <input type=\"hidden\" name=\"signature_1\" v-model=\"formData.signature_1\">\n                <input type=\"hidden\" name=\"signature_1_valid\" v-model=\"signature_1_valid\"\n                       v-validate=\"'required|in:true'\" data-vv-as=\"Signature\" data-vv-delay=\"200\">\n                <span v-show=\"errors.has('signature_1_valid')\"\n                      class=\"error\">{{ errors.first('signature_1_valid') }}</span>\n            </div>\n            <section class=\"col-12\" v-if=\"formData.signature_1\">\n                <label>Current Signature</label>\n                <img :src=\"formData.signature_1\" alt=\"\">\n            </section>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <label for=\"parent_1_print_name\" class=\"label-required\">Print Name*</label>\n                <input type=\"text\" name=\"parent_1_print_name\" id=\"parent_1_print_name\"\n                       v-validate=\"'required'\"\n                       data-vv-as=\"Parent 1 Print Name\"\n                       v-model=\"formData.parent_1_print_name\">\n                <span v-show=\"errors.has('parent_1_print_name')\"\n                      class=\"error\">{{ errors.first('parent_1_print_name') }}</span>\n            </div>\n        </div>\n\n\n        <div class=\"row\" v-show=\"one_parent !== 'Yes'\">\n            <div class=\"col-12\">\n                <p>Please use your mouse to sign electronically in the box below</p>\n                <label for=\"signature_2\">Parent/Carer 2 Signature</label>\n                <canvas id=\"signature_2\" @mousemove=\"draw\" @mousedown=\"mouseDown\" @mouseup=\"mouseUp\"\n                        @mouseout=\"isDrawing = false\"></canvas>\n                <button class=\"clearSignature\" @click.prevent=\"clearCanvas('signature_2')\">Clear Signature</button>\n                <input type=\"hidden\" name=\"signature_2\" v-model=\"formData.signature_2\">\n                <input type=\"hidden\" name=\"signature_2_valid\" v-model=\"signature_2_valid\"\n                       v-validate=\"one_parent !== 'Yes' ? 'required|in:true': ''\" data-vv-as=\"Signature\">\n                <span v-show=\"errors.has('signature_2_valid')\"\n                      class=\"error\">{{ errors.first('signature_2_valid') }}</span>\n            </div>\n            <section class=\"col-12\" v-if=\"formData.signature_2\">\n                <label>Current Signature</label>\n                <img :src=\"formData.signature_2\" alt=\"\">\n            </section>\n        </div>\n        <div class=\"row\" v-show=\"one_parent !== 'Yes'\">\n            <div class=\"col-12\">\n                <input type=\"hidden\" name=\"signature_2\" v-model=\"formData.signature_2\">\n                <label for=\"parent_2_print_name\" class=\"label-required\">Print Name*</label>\n                <input type=\"text\" name=\"parent_2_print_name\" id=\"parent_2_print_name\"\n                       v-validate=\"one_parent !== 'Yes' ? 'required' : ''\"\n                       data-vv-as=\"Parent 2 Print Name\"\n                       v-model=\"formData.parent_2_print_name\">\n                <span v-show=\"errors.has('parent_2_print_name')\"\n                      class=\"error\">{{ errors.first('parent_2_print_name') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.one_parent !== 'Yes'\">\n            <div class=\"col-12\">\n                <label for=\"missing_signature_details\">This application requires the signature of both parents or\n                    carers. If both signatures are not included, please explain the circumstances and supply any\n                    relevant documentation.</label>\n                <input type=\"text\" name=\"missing_signature_details\" id=\"missing_signature_details\"\n                       v-model=\"formData.missing_signature_details\">\n                <span v-show=\"errors.has('missing_signature_details')\"\n                      class=\"error\">{{ errors.first('missing_signature_details') }}</span>\n            </div>\n        </div>\n\n        <div class=\"row\" v-show=\"formData.one_parent !== 'Yes'\">\n            <div class=\"col-12\">\n                <div class=\"form-upload dropzone\" data-field=\"missing_signature_documents\" data-maxFiles=\"2\">\n                    <div class=\"dz-message\">\n                        <p><i class=\"fa fa-cloud-upload fa-2x yellow\" aria-hidden=\"true\"></i></p>\n                        <p>Drop files here or click to upload.</p>\n                        <p>\n                            <small>(Max File Size: {{ maxFileSize }}Mb - Filetypes allowed: {{ fileTypes }} )\n\n                            </small>\n                        </p>\n                        <p class=\"label-note\">Uploading a new file will replace the old file</p>\n                    </div>\n\n                    <section v-if=\"typeof formData.missing_signature_documents === 'object'\">\n                        <p>Current Files:</p>\n                        <p v-for=\"attachment in formData.missing_signature_documents\"\n                           v-bind:key=\"attachment.file.ID\"\n                           v-html=\"attachment.file.title\"></p>\n                        <input type=\"hidden\"\n                               name=\"missing_signature_documents[]\"\n                               v-for=\"attachment in formData.missing_signature_documents\"\n                               v-bind:key=\"attachment.file.ID\"\n                               :value=\"attachment.file.ID\"/>\n                    </section>\n                    <section v-else>\n                        <input v-for=\"attachment in formData.missing_signature_documents\" type=\"hidden\"\n                               v-bind:key=\"attachment\"\n                               name=\"missing_signature_documents[]\"\n                               :value=\"attachment\">\n                    </section>\n                    <span v-show=\"errors.has('missing_signature_documents')\"\n                          class=\"error\">{{ errors.first('missing_signature_documents') }}</span>\n                </div>\n                <!--<input type=\"file\" name=\"missing_signature_documents\" id=\"missing_signature_documents\">-->\n            </div>\n        </div>\n\n        <hr class=\"alt\">\n        <input type=\"hidden\" name=\"id\" :value=\"id\">\n        <input type=\"hidden\" name=\"action\" value=\"enrolStep3\">\n\n        <button type=\"submit\" class=\"button button-alt\" @click.prevent=\"saveContinue(0)\" :disabled=\"disableSubmit\">\n            Complete Form and Pay Application Fee\n        </button>\n\n        <button type=\"submit\" class=\"button button-sm\" @click.prevent=\"saveContinue(1)\">Save and Exit</button>\n        <p v-if=\"disableSubmit\">\n            Payment in progress. Please wait without refreshing this window.\n        </p>\n    </form>\n</template>\n<script>\n  import jsParams from '../jsParams';\n  import Vue from 'vue';\n\n  const Dropzone = require('dropzone');\n\n  export default {\n    props: {\n      one_parent: {\n        type: String,\n        required: true,\n      },\n      form: {\n        type: Object,\n        required: false,\n      },\n      id: {\n        type: Number,\n        required: true,\n      },\n      earlyLearner: {\n        type: Boolean,\n        required: true,\n      },\n    },\n    data() {\n      return {\n        formData: {\n          current_school_grade: '',\n          current_school_still_attending_yes_no: '',\n          learning_difficulty_testing_yes_no: '',\n          learning_difficulty_assistance_yes_no: '',\n          special_needs_yes_no: '',\n          current_school_report: 0,\n          learning_difficulty_testing_reports: 0,\n          special_needs_documents: 0,\n          enrolment_legal_docs: 0,\n          enrolment_policy_confirm: false,\n          missing_signature_documents: 0,\n          signature_1: '',\n          signature_2: '',\n          not_attending: false,\n        },\n        fileTypes: '.png, .jpg, .pdf, .doc, .docx, .gz, .tgz, .zip',\n        maxFileSize: jsParams.maxFileSize,\n        dropzoneContainers: [],\n        isDrawing: false,\n        lastX: 0,\n        lastY: 0,\n        policyFile: {},\n        signature_1_valid: false,\n        signature_2_valid: false,\n        ewayConfig: {},\n        disableSubmit: false,\n      }\n    },\n    created() {\n      if (this.form) {\n        Vue.set(this, 'formData', this.form);\n        if (this.formData.signature_1 !== \"\" && this.formData.signature_1 !== 'data:image/png;base64,') {\n          this.signature_1_valid = true;\n        }\n        if (this.formData.signature_2 !== \"\" && this.formData.signature_2 !== 'data:image/png;base64,') {\n          this.signature_2_valid = true;\n        }\n      }\n    },\n    mounted() {\n      $('html,body').animate({\n        scrollTop: $(this.$el).offset().top - 140,\n      });\n      const vm = this;\n\n      this.policyFile = JSON.parse(document.querySelector('script.enrolment-policy').innerText);\n\n      $('select', this.$el).select2({\n        minimumResultsForSearch: Infinity,\n      })\n        .on('change', e => {\n          const field = e.target.name;\n          if (Object.keys(vm.formData).indexOf(field) !== -1) {\n            Vue.set(vm.formData, field, e.target.value);\n          }\n        });\n\n      const iOS = !!navigator.platform && /iPad|iPhone|iPod/.test(navigator.platform);\n      $('input:checkbox, input:radio').iCheck({\n        checkboxClass: 'icheckbox_minimal-yellow',\n        radioClass: 'iradio_minimal-yellow',\n      }).on('ifChanged', e => {\n        // IOS Fix - don't ask me why but IOS can't cope with unchecking boxes...\n        if (iOS) {\n          if ($(e.target).is(':checked')) {\n            e.target.checked = false;\n            $(e.target).iCheck('uncheck');\n          } else {\n            e.target.checked = true;\n            $(e.target).iCheck('check');\n          }\n        }\n\n        const field = e.target.name;\n        if (Object.keys(this.formData).indexOf(field) !== -1) {\n          Vue.set(this.formData, field, e.target.value);\n        }\n      }).iCheck('update');\n\n      const fileUploads = this.$el.querySelectorAll('.form-upload');\n      Array.from(fileUploads).forEach(container => {\n        const maxFiles = container.dataset.maxfiles || 1;\n\n        const fieldName = container.dataset.field;\n        const dropzone = new Dropzone(container, {\n          url: `${jsParams.ajaxUrl}?action=createAttachment&name=${fieldName}`,\n          paramName: fieldName,\n          addRemoveLinks: true,\n          timeout: null,\n          parallelUploads: 99,\n          maxFiles: +maxFiles,\n          acceptedFiles: 'image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/x-gzip,application/rtf,application/x-tar,application/zip,application/x-compressed-zip',\n          maxFilesize: jsParams.maxFileSize,\n        });\n\n        dropzone.on('success', (file, response) => {\n          // console.log(`${fieldName} ${response}`);\n          if (maxFiles === 1) {\n            Vue.set(vm.formData, fieldName, +response);\n          } else {\n            if (!Array.isArray(vm.formData[fieldName])) {\n              Vue.set(vm.formData, fieldName, []);\n            }\n            vm.formData[fieldName].push(response);\n          }\n        });\n\n        this.dropzoneContainers.push(dropzone);\n      });\n\n      const canvases = this.$el.querySelectorAll('canvas');\n      Array.from(canvases).forEach(canvas => {\n        const ctx = canvas.getContext('2d');\n        ctx.strokeStyle = '#000';\n        ctx.lineJoin = 'round';\n        ctx.lineCap = 'round';\n        ctx.lineWidth = 3;\n\n        canvas.addEventListener('touchstart', e => {\n          e.preventDefault();\n          var touch = e.touches[0];\n          var mouseEvent = new MouseEvent(\"mousedown\", {});\n          const pos = this.getMousePos(canvas, touch);\n          mouseEvent.realX = pos.x;\n          mouseEvent.realY = pos.y;\n          canvas.dispatchEvent(mouseEvent);\n        });\n        canvas.addEventListener('touchend', e => {\n          e.preventDefault();\n          const mouseEvent = new MouseEvent(\"mouseup\", {});\n          canvas.dispatchEvent(mouseEvent);\n        });\n        canvas.addEventListener('touchmove', e => {\n          e.preventDefault();\n\n          const touch = e.touches[0];\n          const mouseEvent = new MouseEvent(\"mousemove\", {});\n          const pos = this.getMousePos(canvas, touch);\n          mouseEvent.realX = pos.x;\n          mouseEvent.realY = pos.y;\n          canvas.dispatchEvent(mouseEvent);\n        });\n      });\n    },\n    methods: {\n      resultCallback(result, transactionID, errors) {\n        const vm = this;\n        // console.log(result, errors);\n        if (result == \"Complete\") {\n          window.location.href = `?AccessCode=${this.ewayConfig.AccessCode}`;\n        } else if (result == \"Error\") {\n          $.ajax({\n            url: jsParams.ajaxUrl,\n            method: 'post',\n            data: {action: 'resetEwayToken', id: vm.id},\n          });\n          alert(\"There was a problem completing the payment: \" + errors);\n        }\n      },\n      submit() {\n        $.ajax({\n          url: jsParams.ajaxUrl,\n          dataType: 'json',\n          method: 'post',\n          data: $(this.$el).serialize(),\n        });\n      },\n      saveSignatures() {\n        const vm = this;\n        const responses = [];\n        return new Promise(resolve => {\n          const canvases = this.$el.querySelectorAll('canvas');\n          Array.from(canvases).forEach(canvas => {\n            const img = canvas.toDataURL(\"image/png\");\n            const paramName = canvas.id;\n            if (vm.formData[paramName] !== '') {\n              return;\n            }\n            responses.push(new Promise(done => {\n                $.ajax({\n                  url: jsParams.ajaxUrl,\n                  data: {action: 'signature', img},\n                  dataType: 'json',\n                  method: 'post',\n                  success(res) {\n                    Vue.set(vm.formData, paramName, res.url);\n                    setTimeout(() => {\n                      done();\n                    }, 1500);\n                  },\n                });\n              })\n            );\n          });\n          Promise.all(responses).then(() => resolve());\n        });\n      },\n      saveContinue(exit) {\n        this.disableSubmit = true;\n        const vm = this;\n        this.$validator.validateAll()\n          .then(isValid => {\n            if (isValid) {\n              this.saveSignatures().then(() => {\n                this.submit();\n                if (exit === 1) {\n                  this.$emit('exit');\n                } else {\n                  $.ajax({\n                    url: jsParams.ajaxUrl,\n                    method: 'post',\n                    data: {action: 'epgw', params: 0, id: vm.id},\n                    dataType: 'json',\n                    success(res) {\n                      vm.ewayConfig = res;\n                      window.eCrypt.showModalPayment(res, vm.resultCallback);\n                      vm.$emit('continue');\n                    },\n                  });\n                }\n              });\n            } else {\n              $('html,body').animate({\n                scrollTop: $(this.$el).offset().top - 140,\n              });\n              vm.disableSubmit = false;\n            }\n          });\n      },\n      draw(e) {\n        if (!this.isDrawing) {\n          return;\n        }\n        const ctx = e.target.getContext('2d');\n        const paramName = e.target.id;\n        Vue.set(this.formData, paramName, '');\n        ctx.beginPath();\n        ctx.moveTo(this.lastX, this.lastY);\n        ctx.lineTo(e.realX || e.offsetX, e.realY || e.offsetY);\n        ctx.stroke();\n        this.lastX = e.realX || e.offsetX;\n        this.lastY = e.realY || e.offsetY;\n        Vue.set(this, `${paramName}_valid`, true);\n      },\n      mouseDown(e) {\n        this.isDrawing = true;\n        this.lastX = e.realX || e.offsetX;\n        this.lastY = e.realY || e.offsetY;\n      },\n      mouseUp() {\n        this.isDrawing = false;\n      },\n      getMousePos(canvasDom, mouseEvent) {\n        var rect = canvasDom.getBoundingClientRect();\n        return {\n          x: mouseEvent.clientX - rect.left,\n          y: mouseEvent.clientY - rect.top,\n        };\n      },\n      clearCanvas(canvas_id) {\n        const canvas = this.$el.querySelector('#' + canvas_id);\n        canvas.width = canvas.width;\n        const ctx = canvas.getContext('2d');\n        ctx.strokeStyle = '#000';\n        ctx.lineJoin = 'round';\n        ctx.lineCap = 'round';\n        ctx.lineWidth = 3;\n        Vue.set(this, `${canvas_id}_valid`, false);\n      },\n    },\n    watch: {\n      'formData.not_attending': function () {\n        const vm = this;\n        setTimeout(() => {\n\n          $('select', this.$el).select2({\n            minimumResultsForSearch: Infinity,\n          })\n            .on('change', e => {\n              const field = e.target.name;\n              if (Object.keys(vm.formData).indexOf(field) !== -1) {\n                Vue.set(vm.formData, field, e.target.value);\n              }\n            });\n        }, 200);\n   