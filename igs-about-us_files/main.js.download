/***/ (function(module, __webpack_exports__, __webpack_require__) {

"use strict";
function init() {
  var longVideoContainer = document.getElementsByClassName("long-video-container")[0];
  var openLongVideoButtons = document.getElementsByClassName("open-long-video-btn");
  var closeVideoContainerBtn = document.getElementById("close_long_video_btn");
  var longVideoTag = document.querySelector(".long-video-wrapper video");
  var longIframeTag = document.querySelector(".long-video-wrapper iframe");

  /*
      * Add the onclick event listener to all the openLongVideoButtons.
      * Note: There might be "zero to many" openLongVideoButtons in the DOM.
      * Note: The counts of openLongVideoButtons depends on if the "banner video" has a "long video" companion.
  */
  if (openLongVideoButtons) {
    for (var i = 0; i < openLongVideoButtons.length; i++) {
      openLongVideoButtons[i].addEventListener("click", function (event) {
        return watchNowBtnClicked(event);
      });
    }
  }

  /*
      * Add the onclick event listener to the closeVideoContainerBtn.
      * Note: There's only ONE closeVideoContainerBtn in the DOM.
  */
  if (closeVideoContainerBtn) closeVideoContainerBtn.addEventListener("click", closeVideoContainer);

  /*
      * The function below:
      * (1) Sets the status of video or iframe tags.
      * (2) Display longVideoContainer.
  */
  function watchNowBtnClicked(event) {
    if (event.target.hasAttribute("videourl")) {
      // Long video source is from "url"
      var videoUrl = event.target.getAttribute("videourl");
      var src = event.target.getAttribute("videosrc");
      setLongIframeAttr(videoUrl, src);
    } else {
      // Long video source is from "local uploading"
      var longVideoSrc = event.target.getAttribute("longvideosrc");
      var type = event.target.getAttribute("longVideoType");
      setLongVideoAttr(longVideoSrc, type);
    }
    showVideoContainer();
  }

  /*
      * Below function display the long-video-container.
  */
  function showVideoContainer() {
    if (longVideoContainer) longVideoContainer.style.display = 'block';
  }

  /*
      * The function below:
      * (1) Resets the status of video and iframe tags,
      * (2) and closes the long-video-container.
  */
  function closeVideoContainer() {
    if (longIframeTag) {
      longIframeTag.style.display = "block";
      longIframeTag.setAttribute("src", "");
    }
    if (longVideoTag) {
      longVideoTag.style.display = "block";
      longVideoTag.setAttribute("src", "");
    }
    if (closeVideoContainerBtn) longVideoContainer.style.display = 'none';
  }

  /*
      * The function below:
      * (1) Sets the video tag's src value.
      * (2) Hide the iframe tag.
  */
  function setLongVideoAttr(url, type) {
    if (longVideoTag) longVideoTag.setAttribute("src", url); // Set scr value
    if (longVideoTag) longVideoTag.setAttribute("type", type); // Set type value
    if (longIframeTag) longIframeTag.style.display = "none"; // Hide iframe tag
  }

  /*
      * The function below:
      * (1) Determine video source url comes from "youtube" or "vimeo".
      * (2) Set iframe tag's src valeu.
      * (3) Hide the video tag.
  */
